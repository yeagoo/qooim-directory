# Generate actual random secrets with pnpm init:env. Local demo values below contain no working secrets.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://network:REPLACE@127.0.0.1:5432/network
AUTH_ENCRYPTION_KEY=
ADMIN_ORIGIN=https://admin.localhost:8443
ALLOW_INSECURE_HTTP=false
OPERATOR_EMAIL=owner@example.test
OPERATOR_PASSWORD=
SEED_DEMO=true
DEMO_ORIGINS=https://atlas.localhost:8443,https://notes.localhost:8443,https://library.localhost:8443

# P3 mail: production SMTP must use TLS; credentials stay outside site snapshots.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_ALLOW_INSECURE=false
# Production defaults to true and requires SMTP. Local demo generated by init:env writes false explicitly.
AUTH_REQUIRE_EMAIL=true
AUTH_HISTORY_DAYS=30
# Trust client IP only from a proxy that injects this private token (>=32 characters).
PROXY_TRUST_TOKEN=

# Optional server-side token for public GitHub repository metadata (separate from reader OAuth).
GITHUB_SYNC_TOKEN=

# Host directory bind-mounted to /app/data/media for uploads. Create it with UID 1000 write access.
MEDIA_HOST_PATH=./data/media

# Retention (worker, hourly). Empty uses defaults; AI history keeps at least 35 days.
# compose.yaml does not pass these through (image evidence input); use compose.override.yaml.
RETENTION_AI_DAYS=
RETENTION_COLLECTOR_TASK_DAYS=
RETENTION_COLLECTOR_SUPERSEDED_DAYS=
RETENTION_COLLECTOR_REVIEWED_DAYS=

# Existing restored database selected by the application (PostgreSQL initial DB remains network).
APP_DATABASE=network
