    "test:p3": "node scripts/test-p0.mjs tests/p3/platform.test.ts",
    "template:preview": "node --import tsx scripts/template-preview.ts",
    "test:p4": "node scripts/test-p0.mjs tests/p4/github.test.ts",
    "source:bundle": "node scripts/release.mjs bundle",
    "source:export": "node scripts/release.mjs export",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:p5": "node scripts/test-p0.mjs tests/p5/operations.test.ts tests/p5/source-download.test.ts",
    "test:p6": "node scripts/test-p0.mjs tests/p6/foundation.test.ts tests/p6/media.test.ts tests/p6/ai.test.ts tests/p6/collectors.test.ts",
