    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "test:p0": "node scripts/test-p0.mjs",
    "check": "tsc --noEmit && node --check scripts/backup.mjs && node --check scripts/release.mjs && node --check scripts/distribution.mjs && node scripts/check-boundaries.mjs && node --check src/ui/admin.js && node --check src/ui/account.js && node --check src/ui/account-home.js && node --check src/ui/content-admin.js && node --check src/ui/directory.js && node --check src/ui/github-admin.js && node --check src/ui/media-admin.js && node --check src/ui/ai-admin.js && node --check src/ui/collector-admin.js && node --check src/ui/limits-admin.js && node --check src/ui/ai-billing-admin.js && node --check src/ui/toolso.js && node --check src/ui/toolso-init.js && node scripts/build-toolso-css.mjs --check",
    "build:css": "node scripts/build-toolso-css.mjs",
    "build:p0": "next build --webpack",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/release.mjs bundle && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
