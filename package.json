    "test:p9": "node scripts/test-p0.mjs tests/p9/foundation.test.ts tests/p9/prompts.test.ts tests/p9/billing.test.ts",
    "test:p10": "node scripts/test-p0.mjs tests/p10/migration.test.ts tests/p10/unified.test.ts tests/p10/ui.test.ts",
    "test:p11": "node scripts/test-p0.mjs tests/p11/foundation.test.ts tests/p11/media.test.ts tests/p11/access-ui.test.ts",
    "test:p12": "node scripts/test-p0.mjs tests/p12/render.test.ts tests/p12/home.test.ts tests/p12/catalog.test.ts tests/p12/browser.test.ts",
    "test:p13": "node scripts/test-p0.mjs tests/p13/migration.test.ts tests/p13/content.test.ts tests/p13/template.test.ts tests/p13/collections.test.ts tests/p13/collections-template.test.ts tests/p13/enrich.test.ts tests/p13/admin-ui.test.ts",
    "test:p14": "node scripts/test-p0.mjs tests/p14/seo.test.ts tests/p14/alternatives-template.test.ts",
    "test:capacity": "node scripts/test-p0.mjs tests/p5/capacity.test.ts",
    "release:check": "node scripts/release.mjs check",
    "test:release": "node --test tests/p5/release.test.mjs",
    "release:check:image": "node scripts/release.mjs check-image",
    "release:inventory": "node scripts/distribution.mjs inventory"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "lucide-react": "0.562.0",
